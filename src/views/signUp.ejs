<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title>Registrarse</title>
</head>
<body>
<script src="/js/auth.js"></script>
<%- include('partials/navbar') %>

<main>
    <div class="container">
        <div class="row">
            <div class="col s12 m8 offset-m2 l6 offset-l3">
                <div class="card z-depth-3" style="margin-top: 24px;">
                    <div class="card-content">
                        <div class="center-align" style="margin-bottom: 16px;">
                            <i class="material-icons large teal-text">person_add</i>
                            <h5>Crear Cuenta</h5>
                        </div>

                        <div id="alert" class="card-panel red lighten-4 red-text text-darken-4" style="display:none;">
                            <i class="material-icons tiny">error_outline</i>
                            <span id="alert-msg"></span>
                        </div>
                        <div id="success" class="card-panel green lighten-4 green-text text-darken-4" style="display:none;">
                            <i class="material-icons tiny">check_circle</i>
                            Cuenta creada exitosamente. Redirigiendo...
                        </div>

                        <form id="signUpForm">
                            <div class="row" style="margin-bottom:0;">
                                <div class="input-field col s12 m6">
                                    <i class="material-icons prefix">person</i>
                                    <input id="name" type="text" required>
                                    <label for="name">Nombre</label>
                                </div>
                                <div class="input-field col s12 m6">
                                    <i class="material-icons prefix">person_outline</i>
                                    <input id="lastName" type="text" required>
                                    <label for="lastName">Apellido</label>
                                </div>
                            </div>
                            <div class="row" style="margin-bottom:0;">
                                <div class="input-field col s12 m6">
                                    <i class="material-icons prefix">email</i>
                                    <input id="email" type="email" required>
                                    <label for="email">Correo electrónico</label>
                                </div>
                                <div class="input-field col s12 m6">
                                    <i class="material-icons prefix">phone</i>
                                    <input id="phoneNumber" type="tel" required>
                                    <label for="phoneNumber">Teléfono</label>
                                </div>
                            </div>
                            <div class="row" style="margin-bottom:0;">
                                <div class="input-field col s12">
                                    <i class="material-icons prefix">cake</i>
                                    <input id="birthdate" type="date" required>
                                    <label for="birthdate" class="active">Fecha de nacimiento</label>
                                </div>
                            </div>
                            <div class="row" style="margin-bottom:0;">
                                <div class="input-field col s12">
                                    <i class="material-icons prefix">lock_outline</i>
                                    <input id="password" type="password" required>
                                    <label for="password">Contraseña</label>
                                    <span class="helper-text">Mín. 8 caracteres, 1 mayúscula, 1 dígito, 1 especial (#$%&*@)</span>
                                </div>
                            </div>
                            <div style="margin-top: 16px;">
                                <button type="submit" class="btn teal waves-effect waves-light" style="width:100%;">
                                    Registrarse <i class="material-icons right">person_add</i>
                                </button>
                            </div>
                        </form>

                        <div class="center-align" style="margin-top: 16px;">
                            <span class="grey-text">¿Ya tienes cuenta?</span>
                            <a href="/signIn" class="teal-text"> Iniciar Sesión</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
<script>
    const pwdRegex = /^(?=.*[A-Z])(?=.*\d)(?=.*[#$%&*@]).{8,}$/;

    document.getElementById('signUpForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        document.getElementById('alert').style.display   = 'none';
        document.getElementById('success').style.display = 'none';

        const password = document.getElementById('password').value;
        if (!pwdRegex.test(password)) {
            showAlert('La contraseña debe tener mín. 8 caracteres, 1 mayúscula, 1 dígito y 1 especial (#$%&*@)');
            return;
        }

        const body = {
            name:        document.getElementById('name').value,
            lastName:    document.getElementById('lastName').value,
            email:       document.getElementById('email').value,
            phoneNumber: document.getElementById('phoneNumber').value,
            birthdate:   document.getElementById('birthdate').value,
            password,
            roles: ['user']
        };

        try {
            const res  = await fetch('/api/auth/signUp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const data = await res.json();

            if (!res.ok) { showAlert(data.message || 'Error al registrarse'); return; }

            document.getElementById('success').style.display  = 'block';
            document.getElementById('signUpForm').style.display = 'none';
            setTimeout(() => window.location.href = '/signIn', 2000);

        } catch (err) {
            showAlert('Error de conexión. Intenta de nuevo.');
        }
    });

    function showAlert(msg) {
        document.getElementById('alert-msg').textContent = msg;
        document.getElementById('alert').style.display = 'block';
    }
</script>
</body>
</html>
