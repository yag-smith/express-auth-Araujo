<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title>Dashboard</title>
</head>
<body>
<script src="/js/auth.js"></script>
<%- include('partials/navbar') %>

<main>
    <div class="container">

        <div id="loading" class="center-align" style="margin-top: 80px;">
            <div class="preloader-wrapper big active">
                <div class="spinner-layer spinner-teal-only">
                    <div class="circle-clipper left"><div class="circle"></div></div>
                    <div class="gap-patch"><div class="circle"></div></div>
                    <div class="circle-clipper right"><div class="circle"></div></div>
                </div>
            </div>
            <p class="grey-text">Cargando...</p>
        </div>

        <div id="content" style="display:none;">
            <div class="row" style="margin-top: 8px;">
                <div class="col s12">
                    <h4 id="welcome-msg" class="teal-text"></h4>
                    <p class="grey-text">Aquí están tus datos de usuario.</p>
                </div>
            </div>
            <div class="row">
                <div class="col s12 m6">
                    <div class="card">
                        <div class="card-content">
                            <span class="card-title">
                                <i class="material-icons teal-text">person</i> Información Personal
                            </span>
                            <table class="striped">
                                <tbody id="user-table"></tbody>
                            </table>
                        </div>
                        <div class="card-action">
                            <a href="/profile" class="teal-text">
                                <i class="material-icons tiny">edit</i> Editar perfil
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col s12 m6">
                    <div class="card teal lighten-5">
                        <div class="card-content center-align">
                            <i class="material-icons large teal-text">account_circle</i>
                            <p id="display-name" class="flow-text teal-text"></p>
                            <div id="display-roles"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', async function () {
        const payload = checkAuth();
        if (!payload) return;

        if (payload.roles && payload.roles.includes('admin')) {
            window.location.href = '/dashboard/admin';
            return;
        }

        try {
            const res = await fetch('/api/users/me', { headers: authHeaders() });
            if (res.status === 401) { logout(); return; }
            const user = await res.json();

            const age       = user.birthdate ? calcAge(user.birthdate) : 'N/A';
            const birthFmt  = user.birthdate ? new Date(user.birthdate).toLocaleDateString('es-ES') : 'N/A';
            const rolesStr  = user.roles ? user.roles.join(', ') : 'user';

            document.getElementById('welcome-msg').textContent = `Bienvenido, ${user.name || ''} ${user.lastName || ''}`;
            document.getElementById('display-name').textContent = `${user.name || ''} ${user.lastName || ''}`;
            document.getElementById('display-roles').innerHTML  = `<span class="chip teal white-text">${rolesStr}</span>`;

            document.getElementById('user-table').innerHTML = `
                <tr><td><b>Nombre</b></td><td>${user.name || ''} ${user.lastName || ''}</td></tr>
                <tr><td><b>Email</b></td><td>${user.email}</td></tr>
                <tr><td><b>Teléfono</b></td><td>${user.phoneNumber || 'N/A'}</td></tr>
                <tr><td><b>Fecha de nac.</b></td><td>${birthFmt}</td></tr>
                <tr><td><b>Edad</b></td><td>${age} años</td></tr>
                <tr><td><b>Dirección</b></td><td>${user.adress || 'N/A'}</td></tr>
                <tr><td><b>Rol</b></td><td>${rolesStr}</td></tr>
            `;

            document.getElementById('loading').style.display = 'none';
            document.getElementById('content').style.display = 'block';

        } catch (err) {
            M.toast({ html: 'Error al cargar datos', classes: 'red' });
        }
    });
</script>
</body>
</html>
